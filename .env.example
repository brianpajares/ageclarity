# Optional maintainer-only settings for `npm run drive:sync`.
# The browser app runs without environment variables.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional report availability notice. Keep both switches false until the
# email domain, database, Turnstile, rate limit, retention and privacy notice
# are ready. Lab values and results are never sent to this endpoint.
NEXT_PUBLIC_REPORT_INTEREST_ENABLED=false
REPORT_INTEREST_ENABLED=false
PRIVACY_NOTICE_APPROVED=false
PRIVACY_NOTICE_VERSION=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
CRON_SECRET=
